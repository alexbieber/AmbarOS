<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/1.0/menu.dtd">
<!-- Ambar Security: a Security folder in Launchpad with one submenu per category, like Kali's menu. -->
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Ambar Security</Name>
    <Directory>ambar-security.directory</Directory>
    <Include><Filename>os.ambar.Security.desktop</Filename></Include>
    <Menu>
      <Name>01-information-gathering</Name>
      <Directory>ambar-security-information-gathering.directory</Directory>
      <Include><Category>X-Ambar-Security-information-gathering</Category></Include>
    </Menu>
    <Menu>
      <Name>02-vulnerability-analysis</Name>
      <Directory>ambar-security-vulnerability-analysis.directory</Directory>
      <Include><Category>X-Ambar-Security-vulnerability-analysis</Category></Include>
    </Menu>
    <Menu>
      <Name>03-web</Name>
      <Directory>ambar-security-web.directory</Directory>
      <Include><Category>X-Ambar-Security-web</Category></Include>
    </Menu>
    <Menu>
      <Name>04-database</Name>
      <Directory>ambar-security-database.directory</Directory>
      <Include><Category>X-Ambar-Security-database</Category></Include>
    </Menu>
    <Menu>
      <Name>05-passwords</Name>
      <Directory>ambar-security-passwords.directory</Directory>
      <Include><Category>X-Ambar-Security-passwords</Category></Include>
    </Menu>
    <Menu>
      <Name>06-wireless</Name>
      <Directory>ambar-security-wireless.directory</Directory>
      <Include><Category>X-Ambar-Security-wireless</Category></Include>
    </Menu>
    <Menu>
      <Name>07-reverse-engineering</Name>
      <Directory>ambar-security-reverse-engineering.directory</Directory>
      <Include><Category>X-Ambar-Security-reverse-engineering</Category></Include>
    </Menu>
    <Menu>
      <Name>08-exploitation</Name>
      <Directory>ambar-security-exploitation.directory</Directory>
      <Include><Category>X-Ambar-Security-exploitation</Category></Include>
    </Menu>
    <Menu>
      <Name>09-sniffing-spoofing</Name>
      <Directory>ambar-security-sniffing-spoofing.directory</Directory>
      <Include><Category>X-Ambar-Security-sniffing-spoofing</Category></Include>
    </Menu>
    <Menu>
      <Name>10-post-exploitation</Name>
      <Directory>ambar-security-post-exploitation.directory</Directory>
      <Include><Category>X-Ambar-Security-post-exploitation</Category></Include>
    </Menu>
    <Menu>
      <Name>11-forensics</Name>
      <Directory>ambar-security-forensics.directory</Directory>
      <Include><Category>X-Ambar-Security-forensics</Category></Include>
    </Menu>
    <Menu>
      <Name>12-reporting</Name>
      <Directory>ambar-security-reporting.directory</Directory>
      <Include><Category>X-Ambar-Security-reporting</Category></Include>
    </Menu>
    <Menu>
      <Name>13-social-engineering</Name>
      <Directory>ambar-security-social-engineering.directory</Directory>
      <Include><Category>X-Ambar-Security-social-engineering</Category></Include>
    </Menu>
  </Menu>
  <Exclude><Category>X-Ambar-Security</Category></Exclude>
</Menu>
