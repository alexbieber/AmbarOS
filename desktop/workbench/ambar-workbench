#!/usr/bin/env python3
"""Ambar Workbench: run security engagements: scope, scans, findings, report.

A window over `ambar-engage`. Every scan goes through it, so every target is
checked against the engagement's scope before anything is sent.
"""
from __future__ import annotations

import html
import json
import os
import shlex
import shutil
import sys
import tomllib
from pathlib import Path

from PySide6.QtCore import QProcess, Qt, QUrl
from PySide6.QtGui import QColor, QDesktopServices
from PySide6.QtWidgets import (QApplication, QComboBox, QDialog, QDialogButtonBox, QFormLayout, QFrame, QGridLayout,
                               QHBoxLayout, QLabel, QLineEdit, QListWidget, QMainWindow, QMessageBox, QPlainTextEdit,
                               QTableWidgetItem, QVBoxLayout)

ENGAGE = shutil.which("ambar-engage") or str(Path(__file__).resolve().parent / "ambar-engage")
HOME = Path(os.environ.get("AMBAR_ENGAGEMENTS", Path.home() / "Engagements"))
CURRENT = Path(os.environ.get("AMBAR_CONFIG", Path.home() / ".config/ambar")) / "engagement"
TOOLS = [
    ("recon-ports", "Ambar Recon: open ports and services", "-p top"),
    ("recon-http", "Ambar Recon: web fingerprint and headers", ""),
    ("recon-tls", "Ambar Recon: TLS and certificate", ""),
    ("recon-subdomains", "Ambar Recon: subdomains (CT logs + DNS)", ""),
    ("nmap", "nmap: service and version scan", "-T4"),
    ("nuclei", "nuclei: template vulnerability checks", ""),
    ("httpx", "httpx: HTTP probing", ""),
    ("ffuf", "ffuf: content discovery (put FUZZ in the URL)", "-w /usr/share/wordlists/dirb/common.txt"),
    ("nikto", "nikto: web server checks", ""),
    ("testssl", "testssl.sh: full TLS audit", ""),
]
SEVERITIES = ["critical", "high", "medium", "low", "info"]
ICON = Path(__file__).with_name("ambar-workbench.svg")

sys.path[:0] = [str(p) for p in (Path(__file__).resolve().parents[1] / "share/python", Path("/usr/lib/ambar/python"))
                if (p / "ambar_ui.py").exists()]
import ambar_ui as ui  # noqa: E402


class NewDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("New engagement")
        self.setMinimumWidth(560)
        v = QVBoxLayout(self)
        v.setContentsMargins(24, 20, 24, 20)
        v.setSpacing(14)
        v.addWidget(ui.label("New engagement", "title"))
        v.addWidget(ui.label("Write down what you're allowed to test. Every scan is checked against this scope.",
                             "subtitle", wrap=True))
        form = QFormLayout()
        form.setSpacing(10)
        form.setLabelAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.name = QLineEdit(placeholderText="ACME external test")
        self.include = QLineEdit(placeholderText="203.0.113.0/24, acme.example, *.acme.example")
        self.exclude = QLineEdit(placeholderText="optional: 203.0.113.1, vpn.acme.example")
        self.auth = QLineEdit(placeholderText="Who authorised it: name, role, date or reference")
        self.ends = QLineEdit(placeholderText="YYYY-MM-DD (optional)")
        form.addRow("Name", self.name)
        form.addRow("In scope", self.include)
        form.addRow("Excluded", self.exclude)
        form.addRow("Authorised by", self.auth)
        form.addRow("Ends", self.ends)
        v.addLayout(form)
        v.addWidget(ui.label("Only test systems you own or have written permission to test.", "notice", wrap=True))
        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        ok = buttons.button(QDialogButtonBox.Ok)
        ok.setText("Create")
        ok.setProperty("kind", "primary")
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        v.addWidget(buttons)

    def args(self) -> list[str]:
        split = lambda s: [x.strip() for x in s.replace("\n", ",").split(",") if x.strip()]  # noqa: E731
        a = ["new", self.name.text().strip(), "--include", *split(self.include.text()),
             "--authorised-by", self.auth.text().strip()]
        if split(self.exclude.text()):
            a += ["--exclude", *split(self.exclude.text())]
        if self.ends.text().strip():
            a += ["--ends", self.ends.text().strip()]
        return a


class Workbench(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Ambar Workbench")
        self.setWindowIcon(ui.app_icon("ambar-workbench", ICON))
        self.resize(1180, 780)
        self.proc: QProcess | None = None
        self._findings: list[dict] = []
        self.tabs = ui.Shell("Workbench", "Security engagements", "ambar-workbench", ICON)

        # Sidebar: engagements
        self.tabs.side.addSpacing(10)
        self.tabs.side.addWidget(ui.label("ENGAGEMENTS", "section"))
        self.list = QListWidget()
        self.list.setObjectName("AmbarNav")
        self.list.setFrameShape(QFrame.NoFrame)
        self.list.currentTextChanged.connect(self.select)
        self.tabs.side.addWidget(self.list, 1)
        new = ui.button("New engagement…", "primary", "list-add")
        new.clicked.connect(self.new_engagement)
        self.tabs.footer.addWidget(new)

        # Scope
        scope = ui.Page("Scope", "What this engagement may touch. Every tool here checks it first.")
        card = ui.Card(padding=22)
        self.scope_view = QLabel()
        self.scope_view.setTextFormat(Qt.RichText)
        self.scope_view.setWordWrap(True)
        self.scope_view.setAlignment(Qt.AlignTop)
        self.scope_view.setTextInteractionFlags(Qt.TextSelectableByMouse)
        card.body.addWidget(self.scope_view)
        scope.body.addWidget(card)
        scope.body.addStretch(1)
        self.tabs.add_page("Scope", scope, "crosshairs")

        # Run
        run = ui.Page("Run", "Scan a target in scope. Output from Recon, nmap and nuclei becomes findings.")
        rc = ui.Card(padding=16)
        self.tool = QComboBox()
        for key, label, default in TOOLS:
            self.tool.addItem(label, (key, default))
        self.tool.currentIndexChanged.connect(lambda _: self.extra.setText(self.tool.currentData()[1]))
        self.target = QLineEdit(placeholderText="Target: host, IP, URL or domain (must be in scope)")
        self.extra = QLineEdit(TOOLS[0][2])
        self.extra.setPlaceholderText("Extra arguments")
        self.run_btn = ui.button("Run", "primary", "media-playback-start")
        self.run_btn.clicked.connect(self.run_tool)
        self.stop_btn = ui.button("Stop", "danger", "process-stop")
        self.stop_btn.setEnabled(False)
        self.stop_btn.clicked.connect(lambda: self.proc and self.proc.kill())
        grid = QGridLayout()
        grid.setHorizontalSpacing(12)
        grid.setVerticalSpacing(6)
        for c, (text, w) in enumerate((("Tool", self.tool), ("Target", self.target), ("Arguments", self.extra))):
            grid.addWidget(ui.label(text.upper(), "section"), 0, c)
            grid.addWidget(w, 1, c)
        grid.addWidget(self.run_btn, 1, 3)
        grid.addWidget(self.stop_btn, 1, 4)
        grid.setColumnStretch(0, 3)
        grid.setColumnStretch(1, 4)
        grid.setColumnStretch(2, 3)
        rc.body.addLayout(grid)
        run.body.addWidget(rc)
        self.output = QPlainTextEdit(readOnly=True)
        self.output.setProperty("console", True)
        self.output.setPlaceholderText("Output appears here.")
        run.body.addWidget(self.output, 1)
        self.tabs.add_page("Run", run, "media-playback-start")

        # Findings
        fw = ui.Page("Findings", "Found automatically from scan output, or added with ambar-engage findings --add.")
        self.stats = {s: ui.Stat(s.capitalize(), "0", s) for s in SEVERITIES}
        fw.body.addLayout(ui.row(*self.stats.values(), spacing=12))
        self.findings = ui.table(["Severity", "Target", "Finding", "Source"], stretch=2)
        self.findings.cellClicked.connect(self.show_detail)
        fw.body.addWidget(self.findings, 2)
        dc = ui.Card(padding=16)
        self.detail = ui.label("Select a finding to see its details.", "muted", wrap=True)
        self.detail.setTextInteractionFlags(Qt.TextSelectableByMouse)
        dc.body.addWidget(self.detail)
        fw.body.addWidget(dc)
        self.tabs.add_page("Findings", fw, "dialog-warning")

        # Report
        rw = ui.Page("Report", "The engagement, who authorised it, the scope, every finding by severity and the activity log.")
        rcard = ui.Card("Create a report", "Written into the engagement folder and opened when it's ready.", padding=20)
        rrow = QHBoxLayout()
        rrow.setSpacing(10)
        for fmt, label, kind in (("pdf", "PDF", "primary"), ("html", "HTML", None), ("md", "Markdown", None)):
            b = ui.button(label, kind, "document-export")
            b.setMinimumWidth(120)
            b.clicked.connect(lambda _=False, f=fmt: self.report(f))
            rrow.addWidget(b)
        rrow.addStretch(1)
        rcard.body.addLayout(rrow)
        self.report_status = ui.label("", "muted", wrap=True)
        self.report_status.setTextInteractionFlags(Qt.TextSelectableByMouse)
        rcard.body.addWidget(self.report_status)
        rw.body.addWidget(rcard)
        rw.body.addStretch(1)
        self.tabs.add_page("Report", rw, "document-export")

        self.setCentralWidget(self.tabs)
        self.reload()

    # ---------------------------------------------------------------- data

    def engagement_dir(self) -> Path | None:
        item = self.list.currentItem()
        return HOME / item.text() if item else None

    def reload(self) -> None:
        names = sorted(p.parent.name for p in HOME.glob("*/scope.toml"))
        cur = CURRENT.read_text().strip() if CURRENT.exists() else ""
        self.list.blockSignals(True)
        self.list.clear()
        self.list.addItems(names)
        self.list.blockSignals(False)
        if names:
            self.list.setCurrentRow(names.index(cur) if cur in names else 0)
        else:
            self.scope_view.setText("<p style='font-size:15pt; font-weight:700'>No engagements yet</p><p>Click <b>New "
                                    "engagement…</b> and write down what you're allowed to test. Every tool here only "
                                    "touches targets in that scope.</p>")

    def select(self, name: str) -> None:
        if not name:
            return
        CURRENT.parent.mkdir(parents=True, exist_ok=True)
        CURRENT.write_text(name)
        d = HOME / name
        cfg = tomllib.loads((d / "scope.toml").read_text())
        e, s = cfg.get("engagement", {}), cfg.get("scope", {})
        t = ui.theme()
        esc = html.escape
        chips = lambda xs, tone: " ".join(  # noqa: E731
            f"<span style='background-color:{ui.mix(t['surface'], t.tone(tone), 0.14)}; color:{t.tone(tone)}; "
            f"font-family:monospace'>&nbsp;{esc(str(x))}&nbsp;</span>" for x in xs) or f"<span style='color:{t['muted']}'>nothing</span>"
        head = lambda text: f"<p style='color:{t['muted']}; font-size:8.5pt; font-weight:700; letter-spacing:1px'>{text}</p>"  # noqa: E731
        self.scope_view.setText(
            f"<p style='font-size:17pt; font-weight:700'>{esc(str(e.get('name', name)))}</p>"
            f"<p style='color:{t['muted']}'>Authorised by <b style='color:{t['text']}'>{esc(str(e.get('authorised_by', '—')))}</b>"
            f" &nbsp;·&nbsp; {esc(str(e.get('starts', '—')))} to {esc(str(e.get('ends', 'open-ended')))}</p>"
            f"{head('IN SCOPE')}<p style='line-height:160%'>{chips(s.get('include', []), 'good')}</p>"
            f"{head('EXCLUDED')}<p style='line-height:160%'>{chips(s.get('exclude', []), 'bad')}</p>"
            f"<p style='color:{t['muted']}; font-size:9pt'>Folder: {esc(str(d))}</p>")
        self.load_findings()

    def load_findings(self) -> None:
        d = self.engagement_dir()
        try:
            f = json.loads((d / "findings.json").read_text()) if d else []
        except (OSError, ValueError):
            f = []
        self._findings = f
        self.findings.setRowCount(len(f))
        for r, x in enumerate(f):
            sev = QTableWidgetItem("●  " + x["severity"].capitalize())
            sev.setForeground(QColor(ui.theme().tone(x["severity"])))
            bold = sev.font()
            bold.setBold(True)
            sev.setFont(bold)
            for c, item in enumerate([sev, QTableWidgetItem(x["target"]), QTableWidgetItem(x["title"]), QTableWidgetItem(x["source"])]):
                self.findings.setItem(r, c, item)
        self.findings.resizeColumnToContents(0)
        self.findings.resizeColumnToContents(1)
        self.findings.resizeColumnToContents(3)
        for sv, stat in self.stats.items():
            stat.set(str(sum(x["severity"] == sv for x in f)))
        self.tabs.setTabText(2, f"Findings ({len(f)})")

    def show_detail(self, row: int, _col: int) -> None:
        x = self._findings[row]
        esc = html.escape
        self.detail.setProperty("role", None)
        ui.restyle(self.detail)
        self.detail.setText(f"<p style='font-size:12pt; font-weight:650'>{esc(x['title'])}</p>"
                            f"<p>{esc(x['target'])} &nbsp;·&nbsp; {esc(x['severity'])}</p><p>{esc(x['detail'] or '')}</p>"
                            f"<p style='color:{ui.theme()['muted']}'>{esc(x['source'])}, {esc(x['found'])}</p>")

    # ---------------------------------------------------------------- actions

    def engage(self, args: list[str], on_done=None) -> None:
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyReadStandardOutput.connect(
            lambda: self.output.appendPlainText(bytes(self.proc.readAllStandardOutput()).decode(errors="replace").rstrip()))
        self.proc.finished.connect(lambda code, _s: self.finished(code, on_done))
        self.run_btn.setEnabled(False)
        self.stop_btn.setEnabled(True)
        self.proc.start(sys.executable, [ENGAGE, *args])

    def finished(self, code: int, on_done) -> None:
        self.run_btn.setEnabled(True)
        self.stop_btn.setEnabled(False)
        self.output.appendPlainText(f"— finished (exit {code}) —\n")
        self.load_findings()
        if on_done:
            on_done(code)

    def run_tool(self) -> None:
        target = self.target.text().strip()
        if not target or not self.engagement_dir():
            self.output.appendPlainText("Choose an engagement and a target first.")
            return
        key, _ = self.tool.currentData()
        args = ["run", key, target]
        if self.extra.text().strip():
            args += ["--", *shlex.split(self.extra.text())]
        self.tabs.setCurrentIndex(1)
        self.output.appendPlainText(f"▶ {key} {target}")
        self.engage(args)

    def new_engagement(self) -> None:
        dlg = NewDialog(self)
        if dlg.exec() != QDialog.Accepted:
            return
        self.create(dlg.args())

    def create(self, args: list[str]) -> None:
        def done(code):
            if code != 0:
                QMessageBox.warning(self, "Engagement not created", self.output.toPlainText().strip().splitlines()[-2])
            self.reload()
        self.engage(args, done)

    def report(self, fmt: str) -> None:
        def done(code):
            d = self.engagement_dir()
            path = d / f"report.{fmt}" if d else None
            if code == 0 and path and path.exists():
                self.report_status.setText(f"Written: {path}")
                if os.environ.get("QT_QPA_PLATFORM") != "offscreen":
                    QDesktopServices.openUrl(QUrl.fromLocalFile(str(path)))
            else:
                self.report_status.setText("The report couldn't be written; see the Run tab.")
        self.engage(["report", "--format", fmt], done)


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Ambar Workbench")
    app.setDesktopFileName("os.ambar.Workbench")
    ui.apply(app)
    w = Workbench()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
