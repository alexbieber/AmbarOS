[Desktop Entry]
Type=Application
Name=Welcome to Ambar
Comment=First-run setup for Ambar
# Not in the live USB session: there the installer is the first thing people need.
Exec=sh -c "grep -qw boot=casper /proc/cmdline || exec ambar-center --welcome"
Icon=os.ambar.AutomationCenter
Terminal=false
NoDisplay=true
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
