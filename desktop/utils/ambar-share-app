#!/usr/bin/env python3
"""Ambar Share: drop files, scan the QR code on your phone, download. Nothing leaves your network."""
from __future__ import annotations

import importlib.machinery
import importlib.util
import shutil
import subprocess
import sys
import threading
from pathlib import Path

from PySide6.QtCore import Qt, QTimer
from PySide6.QtGui import QGuiApplication, QIcon, QPixmap
from PySide6.QtWidgets import (QApplication, QCheckBox, QComboBox, QFileDialog, QHBoxLayout, QLabel, QListWidget,
                               QListWidgetItem, QMainWindow)

CLI = shutil.which("ambar-share") or str(Path(__file__).resolve().parent / "ambar-share")


def _share():
    loader = importlib.machinery.SourceFileLoader("ambar_share", CLI)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("ambar_share", loader))
    sys.modules["ambar_share"] = mod
    loader.exec_module(mod)
    return mod


sys.path[:0] = [str(p) for p in (Path(__file__).resolve().parents[1] / "share/python", Path("/usr/lib/ambar/python"))
                if (p / "ambar_ui.py").exists()]
import ambar_ui as ui  # noqa: E402

ICON = Path(__file__).with_name("ambar-share.svg")


def size(n: float) -> str:
    for unit in ("bytes", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "bytes" else f"{n:.1f} {unit}"
        n /= 1000
    return ""


class ShareWindow(QMainWindow):
    def __init__(self, host: str | None = None):
        super().__init__()
        self.m = _share()
        self.host = host
        self.server = None
        self.setWindowTitle("Ambar Share")
        self.setWindowIcon(ui.app_icon("ambar-share", ICON))
        self.setAcceptDrops(True)
        self.resize(920, 620)
        page = ui.Page("Share files", "Send files to a phone or computer on the same Wi-Fi. Nothing goes through the internet.")
        cols = QHBoxLayout()
        cols.setSpacing(16)

        files = ui.Card("Files", "Drop files anywhere in this window, or add them.")
        self.list = QListWidget()
        self.list.setObjectName("AmbarList")
        self.list.setMinimumHeight(180)
        files.body.addWidget(self.list, 1)
        add = ui.button("Add files…", icon="list-add")
        add.clicked.connect(self.pick)
        clear = ui.button("Remove all", "ghost")
        clear.clicked.connect(lambda: self.server or self.list.clear())
        files.body.addLayout(ui.row(add, None, clear))
        files.body.addWidget(ui.divider())
        self.minutes = QComboBox()
        for m in (10, 30, 60, 240):
            self.minutes.addItem(f"for {m} minutes" if m < 60 else f"for {m // 60} hour{'s' if m > 60 else ''}", m)
        self.minutes.setCurrentIndex(1)
        self.once = QCheckBox("Stop after one download")
        files.body.addLayout(ui.row(ui.label("Available", "muted"), self.minutes, None, self.once))
        self.start = ui.button("Share", "primary", "document-send")
        self.start.setMinimumHeight(38)
        self.start.clicked.connect(self.toggle)
        files.body.addWidget(self.start)
        cols.addWidget(files, 3)

        link = ui.Card(padding=20)
        link.setMinimumWidth(340)
        link.body.addWidget(ui.label("SCAN TO DOWNLOAD", "section"), 0, Qt.AlignHCenter)
        self.qr = QLabel(alignment=Qt.AlignCenter)
        self.qr.setMinimumSize(240, 240)
        self.qr.setStyleSheet(f"background:{ui.theme()['surface2']}; border-radius:12px; color:{ui.theme()['muted']};")
        self.qr.setText("The code appears here\nwhen you share.")
        link.body.addWidget(self.qr, 1)
        self.url = ui.label("", "mono", wrap=True)
        self.url.setAlignment(Qt.AlignCenter)
        self.url.setTextInteractionFlags(Qt.TextSelectableByMouse)
        link.body.addWidget(self.url)
        self.status = ui.label("Not sharing.", "muted", wrap=True)
        self.status.setAlignment(Qt.AlignCenter)
        link.body.addWidget(self.status)
        cols.addWidget(link, 2)
        page.body.addLayout(cols, 1)
        note = ui.label("Each link holds 128 random bits and serves only the files listed. If the firewall is on, "
                        "other devices need it allowed: see Ambar Guard.", "notice", wrap=True)
        page.body.addWidget(note)
        self.setCentralWidget(page)
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.tick)

    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls():
            e.acceptProposedAction()

    def dropEvent(self, e):
        self.add_files([Path(u.toLocalFile()) for u in e.mimeData().urls()])

    def pick(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Choose files to share")
        self.add_files([Path(f) for f in files])

    def add_files(self, files: list[Path]) -> None:
        have = {self.list.item(i).data(Qt.UserRole) for i in range(self.list.count())}
        for f in files:
            if f.is_file() and str(f) not in have:
                have.add(str(f))
                item = QListWidgetItem(QIcon.fromTheme("text-x-generic"), f"{f.name}    ·    {size(f.stat().st_size)}")
                item.setData(Qt.UserRole, str(f))
                self.list.addItem(item)

    def toggle(self) -> None:
        if self.server:
            self.stop()
            return
        files = [Path(self.list.item(i).data(Qt.UserRole)) for i in range(self.list.count())]
        if not files:
            self.status.setText("Add a file first.")
            return
        if len({f.name for f in files}) != len(files):
            self.status.setText("Two files have the same name.")
            return
        self.share = self.m.Share(files, self.minutes.currentData(), self.once.isChecked())
        self.server, url = self.m.serve(self.share, self.host or self.m.lan_ip(), 0)
        threading.Thread(target=self.server.serve_forever, daemon=True).start()
        self.url.setText(url)
        QGuiApplication.clipboard().setText(url)
        self.show_qr(url)
        self.start.setText("Stop sharing")
        self.status.setText("Link copied. Sharing…")
        self.timer.start(500)

    def show_qr(self, url: str) -> None:
        if not shutil.which("qrencode"):
            self.qr.setText("(install qrencode for a QR code)")
            return
        png = subprocess.run(["qrencode", "-o", "-", "-s", "8", "-m", "2", url], capture_output=True).stdout
        pix = QPixmap()
        pix.loadFromData(png)
        self.qr.setPixmap(pix.scaled(240, 240, Qt.KeepAspectRatio, Qt.SmoothTransformation))

    def tick(self) -> None:
        if not self.share.expired():
            self.status.setText(f"Sharing… {self.share.downloads} download{'s' if self.share.downloads != 1 else ''}")
        else:
            self.stop()

    def stop(self) -> None:
        if self.server:
            self.server.shutdown()
            self.server = None
        self.timer.stop()
        self.start.setText("Share")
        self.qr.clear()
        self.qr.setText("The code appears here\nwhen you share.")
        self.url.setText("")
        self.status.setText(f"Stopped after {self.share.downloads} download{'s' if self.share.downloads != 1 else ''}.")


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Ambar Share")
    app.setDesktopFileName("os.ambar.Share")
    ui.apply(app)
    w = ShareWindow()
    w.add_files([Path(a) for a in sys.argv[1:]])
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
