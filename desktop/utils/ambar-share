#!/usr/bin/env python3
"""ambar-share: send files to a phone or another computer on the same network.

    ambar-share FILE... [--minutes 30] [--once] [--host IP] [--port N]

Prints a link (and a QR code when qrencode is installed). Only the files you
name are served, under a random link that can't be guessed; the link stops
working after the time limit, or after the first download with --once. Every
download is printed with the address that fetched it.
"""
from __future__ import annotations

import argparse
import html
import mimetypes
import os
import secrets
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


def lan_ip() -> str:
    """The address other devices on this network can reach (no packet is sent)."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


class Share:
    def __init__(self, files: list[Path], minutes: float, once: bool):
        self.files = {f.name: f for f in files}
        self.token = secrets.token_urlsafe(16)          # 128 random bits
        self.deadline = time.monotonic() + minutes * 60
        self.once = once
        self.done = threading.Event()
        self.downloads = 0

    def expired(self) -> bool:
        return time.monotonic() > self.deadline or self.done.is_set()


def handler(share: Share):
    class H(BaseHTTPRequestHandler):
        server_version = "ambar-share"
        sys_version = ""

        def deny(self, code=404):
            self.send_response(code)
            self.send_header("Content-Length", "0")
            self.end_headers()

        def do_GET(self):
            parts = urllib.parse.unquote(self.path.split("?")[0]).strip("/").split("/")
            # Constant-time token check; anything else is a plain 404.
            if len(parts) < 2 or parts[0] != "s" or not secrets.compare_digest(parts[1], share.token):
                return self.deny()
            if share.expired():
                return self.deny(410)
            if len(parts) == 2:
                return self.index()
            name = "/".join(parts[2:])
            f = share.files.get(name)
            if f is None:
                return self.deny()
            size = f.stat().st_size
            self.send_response(200)
            self.send_header("Content-Type", mimetypes.guess_type(name)[0] or "application/octet-stream")
            self.send_header("Content-Length", str(size))
            self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + urllib.parse.quote(name))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            with open(f, "rb") as fh:
                shutil.copyfileobj(fh, self.wfile, 1 << 20)
            share.downloads += 1
            print(f"  ↓ {name} → {self.client_address[0]}", flush=True)
            if share.once and share.downloads >= len(share.files):
                share.done.set()

        def index(self):
            rows = "".join(
                f"<li><a href='{urllib.parse.quote(n)}'>{html.escape(n)}</a> <small>{f.stat().st_size / 1e6:.1f} MB</small></li>"
                for n, f in share.files.items())
            body = (f"<!doctype html><meta name=viewport content='width=device-width'><title>Ambar Share</title>"
                    f"<body style='font-family:sans-serif;max-width:560px;margin:40px auto;padding:0 16px'>"
                    f"<h2 style='color:#B35C05'>Files shared from Ambar OS</h2><ul style='line-height:2'>{rows}</ul></body>").encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    return H


def serve(share: Share, host: str, port: int) -> tuple[ThreadingHTTPServer, str]:
    srv = ThreadingHTTPServer((host, port), handler(share))
    srv.daemon_threads = True
    url = f"http://{host}:{srv.server_address[1]}/s/{share.token}/"
    if len(share.files) == 1:
        url += urllib.parse.quote(next(iter(share.files)))
    return srv, url


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="ambar-share", description=__doc__.split("\n")[0])
    ap.add_argument("files", nargs="+", type=Path)
    ap.add_argument("--minutes", type=float, default=30)
    ap.add_argument("--once", action="store_true", help="stop after each file is downloaded once")
    ap.add_argument("--host", help="address to share on (default: this computer's network address)")
    ap.add_argument("--port", type=int, default=0)
    a = ap.parse_args(argv)
    files = []
    for f in a.files:
        if not f.is_file():
            print(f"ambar-share: {f} isn't a file", file=sys.stderr)
            return 2
        files.append(f.resolve())
    if len({f.name for f in files}) != len(files):
        print("ambar-share: two files have the same name", file=sys.stderr)
        return 2
    share = Share(files, a.minutes, a.once)
    srv, url = serve(share, a.host or lan_ip(), a.port)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    print(f"Sharing {len(files)} file{'s' if len(files) > 1 else ''} for {a.minutes:g} minutes"
          + (", until downloaded once" if a.once else "") + ":\n\n  " + url + "\n", flush=True)
    if shutil.which("qrencode") and sys.stdout.isatty():
        subprocess.run(["qrencode", "-t", "ansiutf8", url])
    print("Open the link on a device on the same network. Ctrl+C stops sharing.", flush=True)
    try:
        while not share.expired():
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass
    srv.shutdown()
    print(f"Stopped. {share.downloads} download{'s' if share.downloads != 1 else ''}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
