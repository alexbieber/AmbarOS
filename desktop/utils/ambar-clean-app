#!/usr/bin/env python3
"""Ambar Clean: see what takes space and free it, safely."""
from __future__ import annotations

import importlib.machinery
import importlib.util
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QSize, Qt, QTimer
from PySide6.QtWidgets import QApplication, QCheckBox, QHBoxLayout, QLabel, QMainWindow, QVBoxLayout, QWidget

CLI = shutil.which("ambar-clean") or str(Path(__file__).resolve().parent / "ambar-clean")


def _clean():
    loader = importlib.machinery.SourceFileLoader("ambar_clean", CLI)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("ambar_clean", loader))
    sys.modules["ambar_clean"] = mod
    loader.exec_module(mod)
    return mod


sys.path[:0] = [str(p) for p in (Path(__file__).resolve().parents[1] / "share/python", Path("/usr/lib/ambar/python"))
                if (p / "ambar_ui.py").exists()]
import ambar_ui as ui  # noqa: E402

ICON = Path(__file__).with_name("ambar-clean.svg")


class CleanWindow(QMainWindow):
    def __init__(self, runner=None):
        super().__init__()
        self.c = _clean()
        self.runner = runner or self.run_in_terminal
        self.setWindowTitle("Ambar Clean")
        self.setWindowIcon(ui.app_icon("ambar-clean", ICON))
        self.resize(860, 640)
        page = ui.Page("Clean up", "Everything ticked is rebuilt or re-downloaded when it's needed again.")
        page.setObjectName("AmbarContent")
        self.rescan = ui.button("Scan again", icon="view-refresh")
        self.rescan.clicked.connect(self.scan)
        page.actions.addWidget(self.rescan)

        hero = ui.Card(padding=20)
        h = QHBoxLayout()
        h.setSpacing(18)
        logo = QLabel()
        logo.setPixmap(ui.app_icon("ambar-clean", ICON).pixmap(QSize(56, 56)))
        h.addWidget(logo)
        tv = QVBoxLayout()
        tv.setSpacing(2)
        tv.addWidget(ui.label("CAN BE FREED", "section"))
        self.total = ui.label("", "hero")
        tv.addWidget(self.total)
        self.count = ui.label("", "muted")
        tv.addWidget(self.count)
        h.addLayout(tv, 1)
        self.go = ui.button("Clean", "primary", "edit-clear-all")
        self.go.setMinimumWidth(130)
        self.go.clicked.connect(self.clean)
        h.addWidget(self.go, 0, Qt.AlignVCenter)
        hero.body.addLayout(h)
        page.body.addWidget(hero)
        page.section("What can go")
        self.listcard = ui.Card(padding=6)
        self.grid = QVBoxLayout()
        self.grid.setSpacing(0)
        self.listcard.body.addLayout(self.grid)
        page.body.addWidget(self.listcard)
        page.body.addStretch(1)
        self.setCentralWidget(page)
        self.boxes: dict[str, QCheckBox] = {}
        self.scan()

    def scan(self) -> None:
        def clear(layout):
            while layout.count():
                it = layout.takeAt(0)
                if it.widget():
                    it.widget().deleteLater()
                elif it.layout():
                    clear(it.layout())
        clear(self.grid)
        self.items = self.c.items()
        self.boxes = {}
        for n, i in enumerate(self.items):
            if n:
                self.grid.addWidget(ui.divider())
            row = QHBoxLayout()
            row.setContentsMargins(12, 10, 14, 10)
            row.setSpacing(12)
            box = QCheckBox()
            box.setChecked(i.safe and self.c.worth(i))
            box.setEnabled(self.c.worth(i))
            box.toggled.connect(self.update_total)
            box.setAccessibleName(i.title)
            self.boxes[i.id] = box
            row.addWidget(box, 0, Qt.AlignTop)
            text = QVBoxLayout()
            text.setSpacing(2)
            title = QHBoxLayout()
            title.setSpacing(8)
            title.addWidget(ui.label(i.title, "cardtitle"))
            if not i.safe:
                title.addWidget(ui.badge("Permanent", "warn"))
            title.addStretch(1)
            text.addLayout(title)
            about = ui.label(i.about, "muted", wrap=True)
            about.setTextFormat(Qt.PlainText)
            text.addWidget(about)
            row.addLayout(text, 1)
            amount = self.c.human(i.size) if i.size else (f"{i.count} to remove" if i.count else "Nothing")
            size = ui.label(amount, "cardtitle" if self.c.worth(i) else "muted")
            row.addWidget(size, 0, Qt.AlignTop | Qt.AlignRight)
            holder = QWidget()
            holder.setLayout(row)
            holder.mousePressEvent = lambda _e, b=box: b.isEnabled() and b.toggle()
            self.grid.addWidget(holder)
        self.update_total()

    def chosen(self) -> list[str]:
        return [k for k, b in self.boxes.items() if b.isChecked()]

    def update_total(self) -> None:
        total = sum(i.size for i in self.items if i.id in self.chosen())
        self.total.setText(self.c.human(total))
        n = len(self.chosen())
        self.count.setText(f"{n} item{'s' if n != 1 else ''} selected. Emptying the Trash is permanent." if n
                           else "Nothing selected.")
        self.go.setEnabled(bool(n))

    def clean(self) -> None:
        args = ["run", *self.chosen()]
        if "trash" in self.chosen():
            args.append("--yes")  # the checkbox is the confirmation; its label says it's permanent
        self.runner(args)

    def run_in_terminal(self, args: list[str]) -> None:
        cmd = " ".join(shlex.quote(a) for a in [CLI, *args])
        term = shutil.which("konsole")
        p = subprocess.Popen([term, "--hold", "-e", "sh", "-c", cmd] if term else ["x-terminal-emulator", "-e", "sh", "-c", cmd])
        self.poll(p)

    def poll(self, p) -> None:
        if p.poll() is None:
            QTimer.singleShot(1000, lambda: self.poll(p))
        else:
            self.scan()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Ambar Clean")
    app.setDesktopFileName("os.ambar.Clean")
    ui.apply(app)
    w = CleanWindow()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
