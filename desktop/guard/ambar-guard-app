#!/usr/bin/env python3
"""Ambar Guard: this computer's security checks, one-click fixes and live network connections."""
from __future__ import annotations

import importlib.machinery
import importlib.util
import ipaddress
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QRectF, Qt, QTimer
from PySide6.QtGui import QColor, QPainter, QPen
from PySide6.QtWidgets import (QApplication, QFrame, QGridLayout, QHBoxLayout, QLabel, QMainWindow, QScrollArea,
                               QTableWidget, QTableWidgetItem, QVBoxLayout, QWidget)

CLI = shutil.which("ambar-guard") or str(Path(__file__).resolve().parent / "ambar-guard")


def _guard():
    loader = importlib.machinery.SourceFileLoader("ambar_guard", CLI)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("ambar_guard", loader))
    sys.modules["ambar_guard"] = mod
    loader.exec_module(mod)
    return mod


sys.path[:0] = [str(p) for p in (Path(__file__).resolve().parents[1] / "share/python", Path("/usr/lib/ambar/python"))
                if (p / "ambar_ui.py").exists()]
import ambar_ui as ui  # noqa: E402

SEV = ["critical", "high", "medium", "low", "info"]
MARK = {"pass": ("Passed", "good"), "fail": ("Needs attention", "bad"), "skip": ("Not checked", "neutral")}


class GuardWindow(QMainWindow):
    def __init__(self, runner=None):
        super().__init__()
        self.g = _guard()
        self.runner = runner or self.run_in_terminal
        self.setWindowTitle("Ambar Guard")
        self.setWindowIcon(ui.app_icon("ambar-guard", Path(__file__).with_name("ambar-guard.svg")))
        self.resize(1040, 740)
        self.shell = ui.Shell("Guard", "Security & privacy", "ambar-guard", Path(__file__).with_name("ambar-guard.svg"))

        # Overview: score, counts, every check
        page = ui.Page("Overview", "How well this computer is protected, and one-click fixes for what isn't.")
        recheck = ui.button("Check again", icon="view-refresh")
        recheck.clicked.connect(self.refresh_checks)
        self.fix_all = ui.button("Fix everything", "primary", "tools-wizard")
        self.fix_all.clicked.connect(lambda: self.runner(["fix", "--all"]))
        page.actions.addWidget(recheck)
        page.actions.addWidget(self.fix_all)
        hero = ui.Card(padding=20)
        hrow = QHBoxLayout()
        hrow.setSpacing(20)
        self.ring = ScoreRing()
        hrow.addWidget(self.ring)
        htext = QVBoxLayout()
        htext.setSpacing(4)
        htext.addWidget(ui.label("SECURITY SCORE", "section"))
        self.score = ui.label("", "hero")
        htext.addWidget(self.score)
        self.score_text = ui.label("", "muted", wrap=True)
        htext.addWidget(self.score_text)
        htext.addStretch(1)
        hrow.addLayout(htext, 1)
        stats = QGridLayout()
        stats.setSpacing(10)
        self.stat_pass = ui.Stat("Passed", "0", "good")
        self.stat_fail = ui.Stat("Need attention", "0", "bad")
        self.stat_skip = ui.Stat("Not checked", "0", "neutral")
        for i, w in enumerate((self.stat_pass, self.stat_fail, self.stat_skip)):
            w.setMinimumWidth(130)
            stats.addWidget(w, 0, i)
        hrow.addLayout(stats)
        hero.body.addLayout(hrow)
        page.body.addWidget(hero)
        page.section("Checks")
        self.list = QWidget()
        self.list.setObjectName("AmbarContent")
        self.grid = QVBoxLayout(self.list)
        self.grid.setContentsMargins(0, 0, 4, 0)
        self.grid.setSpacing(8)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(self.list)
        scroll.setFrameShape(QFrame.NoFrame)
        page.body.addWidget(scroll, 1)
        self.shell.add_page("Overview", page, "security-high")

        # Network
        net = ui.Page("Network", "Which apps accept connections, and which ones are talking to other computers. Live.")
        self.stat_listen = ui.Stat("Listening", "0", "accent")
        self.stat_exposed = ui.Stat("Reachable from the network", "0", "bad")
        self.stat_talk = ui.Stat("Open connections", "0", "info")
        net.body.addLayout(ui.row(self.stat_listen, self.stat_exposed, self.stat_talk, None))
        lc = ui.Card("Listening for connections", "Anything marked network can be reached by other computers.")
        self.listening = ui.table(["App", "Protocol", "Address", "Port", "Reachable from"], stretch=2)
        lc.body.addWidget(self.listening)
        net.body.addWidget(lc, 1)
        tc = ui.Card("Talking to", "Open connections from apps on this computer.")
        self.talking = ui.table(["App", "Protocol", "Remote address", "Port", "State"], stretch=2)
        tc.body.addWidget(self.talking)
        net.body.addWidget(tc, 2)
        self.shell.add_page("Network", net, "network-wired")
        self.shell.footer.addWidget(ui.label("Connections are read from the kernel every 2 seconds.", "muted", wrap=True))
        self.setCentralWidget(self.shell)

        self.refresh_checks()
        self.refresh_net()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh_net)
        self.timer.start(2000)

    def refresh_checks(self) -> None:
        self.checks = self.g.all_checks()
        s = self.g.score(self.checks)
        kind = "good" if s >= 80 else "warn" if s >= 50 else "bad"
        self.score.setText(f"{s} <span style='font-size:14pt; color:{ui.theme()['muted']}'>/ 100</span>")
        self.ring.set(s, ui.theme().tone(kind))
        failed = [c for c in self.checks if c.status == "fail"]
        self.score_text.setText(f"{len(failed)} of {len(self.checks)} checks need attention." if failed
                                else "Everything checked looks good.")
        self.stat_pass.set(str(sum(c.status == "pass" for c in self.checks)))
        self.stat_fail.set(str(len(failed)))
        self.stat_skip.set(str(sum(c.status == "skip" for c in self.checks)))
        self.fix_all.setEnabled(any(c.fix for c in failed))
        while self.grid.count():
            w = self.grid.takeAt(0).widget()
            if w:
                w.deleteLater()
        order = {"fail": 0, "pass": 1, "skip": 2}
        for c in sorted(self.checks, key=lambda c: (order[c.status], SEV.index(c.severity) if c.severity in SEV else 9)):
            self.grid.addWidget(self.check_card(c))
        self.grid.addStretch(1)

    def check_card(self, c) -> QFrame:
        card = ui.Card(padding=14)
        h = QHBoxLayout()
        h.setSpacing(14)
        text, kind = MARK[c.status]
        dot = QLabel()
        dot.setFixedSize(10, 10)
        dot.setStyleSheet(f"background:{ui.theme().tone(kind)}; border-radius:5px;")
        h.addWidget(dot, 0, Qt.AlignTop | Qt.AlignLeft)
        v = QVBoxLayout()
        v.setSpacing(3)
        title = QHBoxLayout()
        title.setSpacing(8)
        title.addWidget(ui.label(c.title, "cardtitle"))
        title.addWidget(ui.badge(c.severity.capitalize(), c.severity))
        title.addStretch(1)
        v.addLayout(title)
        detail = ui.label(c.detail, "muted", wrap=True)
        detail.setTextFormat(Qt.PlainText)
        v.addWidget(detail)
        if c.status == "fail" and c.fix_text:
            how = ui.label("Fix: " + c.fix_text, wrap=True)
            how.setTextFormat(Qt.PlainText)
            v.addWidget(how)
        h.addLayout(v, 1)
        right = QVBoxLayout()
        right.addWidget(ui.badge(text, kind), 0, Qt.AlignRight)
        if c.status == "fail" and c.fix:
            b = ui.button("Fix", "primary")
            b.setProperty("check", c.id)
            b.clicked.connect(lambda _=False, i=c.id: self.runner(["fix", i]))
            right.addWidget(b, 0, Qt.AlignRight)
        right.addStretch(1)
        h.addLayout(right)
        card.body.addLayout(h)
        return card

    def refresh_net(self) -> None:
        conns = self.g.connections()
        listen = [c for c in conns if c["state"] == "LISTEN"]
        talk = [c for c in conns if c["state"] not in ("LISTEN", "TIME_WAIT")]
        reach = lambda c: "this computer only" if ipaddress.ip_address(c["local_ip"]).is_loopback else "network"  # noqa: E731
        self.fill(self.listening, sorted(listen, key=lambda c: (c["process"], c["local_port"])), lambda c: [
            c["process"] or "?", c["proto"], c["local_ip"], str(c["local_port"]), reach(c)])
        self.fill(self.talking, sorted(talk, key=lambda c: (c["process"], c["remote_ip"])), lambda c: [
            c["process"] or "?", c["proto"], c["remote_ip"], str(c["remote_port"]), c["state"].replace("_", " ").lower()])
        self.stat_listen.set(str(len(listen)))
        self.stat_exposed.set(str(sum(reach(c) == "network" for c in listen)))
        self.stat_talk.set(str(len(talk)))

    @staticmethod
    def fill(t: QTableWidget, rows: list[dict], cols) -> None:
        t.setRowCount(len(rows))
        for r, row in enumerate(rows):
            for c, val in enumerate(cols(row)):
                item = QTableWidgetItem(val)
                if val == "network":
                    item.setForeground(QColor(ui.theme()["bad"]))
                    f = item.font()
                    f.setBold(True)
                    item.setFont(f)
                t.setItem(r, c, item)


class ScoreRing(QWidget):
    """The score as a ring, like Activity rings."""

    def __init__(self):
        super().__init__()
        self.setFixedSize(96, 96)
        self.value, self.colour = 0, "#888"

    def set(self, value: int, colour: str) -> None:
        self.value, self.colour = value, colour
        self.update()

    def paintEvent(self, _e):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(8, 8, 80, 80)
        pen = QPen(QColor(ui.theme()["surface2"]), 10)
        pen.setCapStyle(Qt.RoundCap)
        p.setPen(pen)
        p.drawEllipse(r)
        pen.setColor(QColor(self.colour))
        p.setPen(pen)
        p.drawArc(r, 90 * 16, -int(360 * 16 * self.value / 100))
        p.end()


    def run_in_terminal(self, args: list[str]) -> None:
        cmd = " ".join(shlex.quote(a) for a in [CLI, *args])
        term = shutil.which("konsole")
        argv = [term, "--hold", "-e", "sh", "-c", cmd] if term else ["x-terminal-emulator", "-e", "sh", "-c", cmd]
        p = subprocess.Popen(argv)
        QTimer.singleShot(1000, lambda: self.wait_and_refresh(p))

    def wait_and_refresh(self, p: subprocess.Popen) -> None:
        if p.poll() is None:
            QTimer.singleShot(1000, lambda: self.wait_and_refresh(p))
        else:
            self.refresh_checks()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Ambar Guard")
    app.setDesktopFileName("os.ambar.Guard")
    ui.apply(app)
    w = GuardWindow()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
