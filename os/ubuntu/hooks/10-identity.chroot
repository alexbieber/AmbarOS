#!/bin/bash
# OS identity: "Ambar OS", based on Ubuntu (ID_LIKE keeps Ubuntu tooling working).
set -euo pipefail
# Read Ubuntu's originals (the diverted copies on a re-run) so this is idempotent.
# shellcheck source=/dev/null
. "$(dpkg-divert --truename /usr/lib/os-release)"
dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<OS
PRETTY_NAME="Ambar OS ${AMBAR_VERSION}"
NAME="Ambar OS"
VERSION_ID="${AMBAR_VERSION}"
VERSION="${AMBAR_VERSION} (based on Ubuntu ${VERSION_ID} LTS)"
VERSION_CODENAME=${VERSION_CODENAME}
ID=ambar
ID_LIKE="ubuntu debian"
UBUNTU_CODENAME=${UBUNTU_CODENAME:-$VERSION_CODENAME}
HOME_URL="https://github.com/alexbieber/AmbarOS"
DOCUMENTATION_URL="https://alexbieber.github.io/AmbarOS/"
SUPPORT_URL="https://alexbieber.github.io/AmbarOS/troubleshooting/"
BUG_REPORT_URL="https://github.com/alexbieber/AmbarOS/issues"
LOGO=ambar-logo
OS
case "${AMBAR_FLAVOR:-standard}" in
  security) printf 'VARIANT="Security Edition"\nVARIANT_ID=security\n' >> /usr/lib/os-release
            sed -i 's/^PRETTY_NAME="Ambar OS /PRETTY_NAME="Ambar OS Security /' /usr/lib/os-release ;;
esac
echo "${AMBAR_FLAVOR:-standard}" > /etc/ambar-flavor
ln -sf ../usr/lib/os-release /etc/os-release
# lsb_release: keep DISTRIB_ID/CODENAME as Ubuntu so PPAs and vendor .deb
# installers that check them keep working; only the description is ours.
# shellcheck source=/dev/null
. "$(dpkg-divert --truename /etc/lsb-release)"
dpkg-divert --quiet --local --rename --add /etc/lsb-release
cat > /etc/lsb-release <<LSB
DISTRIB_ID=${DISTRIB_ID}
DISTRIB_RELEASE=${DISTRIB_RELEASE}
DISTRIB_CODENAME=${DISTRIB_CODENAME}
DISTRIB_DESCRIPTION="Ambar OS ${AMBAR_VERSION} (based on ${DISTRIB_DESCRIPTION})"
LSB
printf 'Ambar OS %s \\n \\l\n\n' "$AMBAR_VERSION" > /etc/issue
echo "Ambar OS $AMBAR_VERSION" > /etc/issue.net
# Live session user (casper).
cat > /etc/casper.conf <<CC
export USERNAME="ambar"
export USERFULLNAME="Ambar Live"
export HOST="ambar-os"
export BUILD_SYSTEM="Ubuntu"
export FLAVOUR="Ambar"
CC
echo ambar-os > /etc/hostname
