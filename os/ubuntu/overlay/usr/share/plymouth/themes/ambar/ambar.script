# Ambar OS boot animation: dark background, the Ambar mark, an amber progress bar.
Window.SetBackgroundTopColor(0.10, 0.086, 0.07);
Window.SetBackgroundBottomColor(0.027, 0.031, 0.047);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 1);

bar.w = 220; bar.h = 4;
track.image = Image.Scale(Image.Text(" ", 0.23, 0.19, 0.16), bar.w, bar.h);
track.sprite = Sprite(track.image);
bar.x = Window.GetX() + Window.GetWidth() / 2 - bar.w / 2;
bar.y = logo.y + logo.image.GetHeight() + 56;
track.sprite.SetPosition(bar.x, bar.y, 1);
fill.sprite = Sprite();
fill.sprite.SetPosition(bar.x, bar.y, 2);

fun progress_cb(duration, progress) {
  w = Math.Int(bar.w * progress);
  if (w < 2) w = 2;
  fill.image = Image.Scale(Image.Text(" ", 0.95, 0.64, 0.23), w, bar.h);
  fill.sprite.SetImage(fill.image);
}
Plymouth.SetBootProgressFunction(progress_cb);

# Password prompt (encrypted disks).
fun display_password_cb(prompt, bullets) {
  msg.image = Image.Text(prompt + "  " + bullets, 0.97, 0.96, 0.94);
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - msg.image.GetWidth() / 2, bar.y + 30, 3);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);
fun display_normal_cb() { if (msg.sprite) msg.sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(display_normal_cb);
